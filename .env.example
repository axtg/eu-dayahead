# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys
ENTSOE_API_KEY=your-entsoe-api-key-here
LOGTAIL_TOKEN=your-logtail-token-here
LOGTAIL_ENDPOINT=your-logtail-http-endpoint-here

# Cache: upstream raw prices are cached per country. Entries refresh after the
# daily ENTSOE publish boundary (~14:30 CET) and at country-local midnight, so we
# make ~2 upstream calls per country per day when ENTSOE is healthy, with short
# retries when it isn't. No knob.

# Rate Limiting
# Max requests per IP per second for /api endpoints
RATE_LIMIT_RPS=10

# CORS Configuration
CORS_ORIGIN=*
