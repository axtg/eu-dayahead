{
  "name": "european-energy-prices-api",
  "version": "1.0.0",
  "description": "Multi-country European energy prices API with provider markup support",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o public/tailwind.css --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-api": "node -e \"const parser = require('@apidevtools/swagger-parser'); parser.validate('docs/openapi.yaml').then(() => console.log('✅ OpenAPI spec is valid')).catch(err => { console.error('❌ OpenAPI validation failed:', err.message); process.exit(1); })\"",
    "docker:build": "docker build -f docker/Dockerfile -t eu-energy-api .",
    "docker:run": "docker run -p 3000:3000 eu-energy-api"
  },
  "keywords": [
    "energy",
    "prices",
    "europe",
    "electricity",
    "api",
    "stekker",
    "entsoe",
    "day-ahead-prices"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
